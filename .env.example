# Token privado do bot. Nunca envie este valor para o Git.
DISCORD_TOKEN=

# Servidor onde o bot será usado.
DISCORD_GUILD_ID=

# Canal público/controlado onde usuários enviam /enviar-ficha.
DISCORD_SUBMISSION_CHANNEL_ID=

# Canal privado onde os administradores recebem Importar/Descartar.
DISCORD_REVIEW_CHANNEL_ID=

# IDs dos administradores que podem clicar nos botões, separados por vírgula.
DISCORD_ADMIN_USER_IDS=

# Dias que uma submissão pode ficar em quarentena antes de expirar.
DISCORD_SUBMISSION_TTL_DAYS=14

# ClamAV/clamd. O padrão funciona com o docker-compose deste projeto.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000

# GitHub: a chave privada NÃO deve ser colocada neste arquivo.
# A aplicação procura .secrets/github_deploy_key por padrão.
# Use esta variável apenas se precisar usar outro caminho local.
# GIT_DEPLOY_KEY_PATH=.secrets/github_deploy_key
