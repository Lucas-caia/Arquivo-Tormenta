{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist-server",
    "rootDir": ".",
    "types": [
      "node",
      "express",
      "multer"
    ]
  },
  "include": [
    "server/**/*.ts",
    "discord/**/*.ts",
    "shared/**/*.ts"
  ],
  "exclude": [
    "server/**/*.test.ts"
  ]
}
