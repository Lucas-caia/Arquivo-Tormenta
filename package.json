{
  "name": "arquivo-tormenta-rpg",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:web\" \"npm:dev:server\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "tsx --test server/*.test.ts discord/*.test.ts discord/security/*.test.ts discord/submissions/*.test.ts",
    "check": "npm run typecheck && npm run test && vite build",
    "dev:web": "vite --host 0.0.0.0",
    "dev:server": "tsx watch server/server.ts",
    "bot": "tsx discord/bot.ts",
    "bot:compiled": "node dist-server/discord/bot.js",
    "clamav:check": "tsx discord/security/checkClamav.ts"
  },
  "dependencies": {
    "express": "4.19.2",
    "lucide-react": "0.468.0",
    "multer": "1.4.5-lts.1",
    "pdf-lib": "1.17.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/multer": "1.4.12",
    "@types/node": "22.10.2",
    "@types/react": "18.3.17",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.1.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vite": "6.3.5"
  },
  "optionalDependencies": {
    "discord.js": "14.27.0"
  }
}
